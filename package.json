{
  "name": "vehicle-selection-form",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:frontend": "npm run test -w frontend",
    "test:backend": "npm run test -w backend",
    "test:watch": "concurrently -n backend,frontend -c blue,magenta \"npm run test:watch -w backend\" \"npm run test:watch -w frontend\"",
    "test:watch:frontend": "npm run test:watch -w frontend",
    "test:watch:backend": "npm run test:watch -w backend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
